# Core deployment/image settings
PROJECT_ID=your-gcp-project-id
IMAGE_TAG=dev
GCS_LOGGING_BUCKET=your-airflow-log-bucket

# Airflow + GCP connections
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
AIRFLOW_CONN_GOOGLE_CLOUD_DEFAULT=google-cloud-platform://?extra__google_cloud_platform__project=your-gcp-project-id
AIRFLOW_CONN_SLACK_WEBHOOK=<set-your-slack-webhook-url>

# Postgres (Airflow metadata DB)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=airflow

# Airflow bootstrap admin account
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=replace-with-strong-password
