REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(location,r'Ã©', 'é'),r'Ã¨', 'è'),r'Ã¢', 'â'),r'Ã´', 'ô'),
