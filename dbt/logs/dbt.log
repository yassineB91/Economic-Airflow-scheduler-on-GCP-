    create or replace table `processing-dev-394419`.`freework`.`jobs_modeling_ref_job_category`
      
    
    

    OPTIONS()
    as (
      

with source_data as (
with jobs as (
select  distinct array_to_string(freework.remove_stop_words(TEXT_ANALYZE(REGEXP_REPLACE(NORMALIZE(job, NFD), r"\pM", ''), analyzer=>'PATTERN_ANALYZER')),' ') as title,job, job_id
from `processing-dev-394419`.`freework`.`jobs_modeling_fact_jobs_initial`

)
select distinct title,job,job_id,
case
when title like '%architecte%' or title like '%architect%'
then "Architecture"
when title like '%devops%' or title like '%kubernetes%' or title like '%ansible%' or title like '%sauvegarde%' or title like '%supervision%' or title like '%infra%' or title like '%sysops%'
then 'Devops'
when title like '%dev%' or title like '%java%'or title like '%drupal%' or title like '%developpeur%'  or title like '%backend%'  or title like '%frontend%'  or title like '%php%' or title like '%software%' or title like '%react%' or title like '%front%' or title like '%js%' or title like '%angular%'
then 'Dev'
when title like '%scrum master%' or title like '%coach%'
then "Agile"
when title like '%erp%' or title like '%sap%' or title like '%dynamics%' or title like '%oracle ebs%' or title like '%sd%' or title like '%mm%' or title like '%fi co%' or  title like '%hana%' or  title like '%wms%' or  title like '%salesforce%' or  title like '%sales force%' or  title like '%microsoft%' or  title like '%sage%' or  title like '%ivalua%' or  title like '%maximo%' or  title like '%workday%'
then "ERP"
when title like '%data%' or title like '%rgpd%' or title like '%informatica%' or title like '%talend%' or title like '%odi%'  or title like '%etl%' or title like '%machine learning%' or title like '%bi%' or title like '%kafka%' or title like '%sas%'
then "Data"
when title like '%technicien%'
then "Technicien"
when title like '%directeur%' or title like '%direction%' or title like '%manager%'
then "Direction"
when title like '%dba%' or title like '%oracle%' or title like '%sql%'
then "DBA"
when title like '%business analyst%' or title like '%business analysis%' or title like '%fonctionnel%'
then "Business Analysis"
when title like '%po%' or title like 'product owner' or title like '%chef projet%' or title like '%product%' or title like '%projet%' or title like '%project%' or title like '%change%' or title like '%pmo%' or title like '%pm%'
then "Project management"
when title like '%testeur%' or title like '%test%' or title like '%qa%' or title like '%recette%' or title like '%quality%'
then "Test"
when title like '%securite%' or title like '%cyber%' or title like '%security%' or title like '%soc%'
then "Security"
when title like '%reseau%' or title like '%network%' or title like '%cisco%'
then "Reseau"
when title like '%cloud%'
then "Cloud"
when title like '%moa%' or title like '%maitrise ouvrage%'
then "MOA"
when title like '%vmware%' or title like '%virtualisation%'
then "Virtualization"
when title like '%linux%' or title like '%admin%' or title like '%administrateur%' or title like '%administration%'
then "System Administration"
when title like '%controleur gestion%' or title like '%controle gestion%' or title like '%administration%'
then "Controle de Gestion"
when title like '%manager%'
then "Management"
when title like '%servicenow%' or title like '%service now%' or title like '%aveva%' or title like '%cmdb%'
then "CMDB"
else "other"
end as job_category
from jobs )

select * from source_data
    );
  
