    REGEXP_EXTRACT(LOWER(description), r'\b(au\s+moins\s+(?:[1-9]|1[0-4]|une?|deux|trois|quatre|cinq|six|sept|huit|neuf|dix|onze|douze|treize|quatorze))\s*(?:ans?|années?|years?)\b'),

