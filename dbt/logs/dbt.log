    create or replace table `processing-dev-394419`.`freework`.`jobs_cleaning_freelance_cdi__dbt_tmp`
      
    partition by insert_date
    

    OPTIONS(
      expiration_timestamp=TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL 12 hour)
    )
    as (
      

with source_data as (
select 
split(title,"-")[0] as job,
"CDI or Freelance" as job_type,

    
        safe_cast(replace(split(split(column_name,",")[SAFE_OFFSET(0)],"-")[SAFE_OFFSET(0)],"k","000") as numeric)
        
 as salary_min,

    
        safe_cast(replace(split(split(column_name,",")[SAFE_OFFSET(0)],"-")[SAFE_OFFSET(1)],"k €/an","000") as numeric)
    
 as salary_max,

    
        safe_cast(split(split(salary_tjm,",")[SAFE_OFFSET(1)],"-")[SAFE_OFFSET(0)] as numeric)
        
 as tjm_min,

    
        safe_cast(replace(split(split(salary_tjm,",")[SAFE_OFFSET(1)],"-")[SAFE_OFFSET(1)]," €/j","") as numeric)
    
 as tjm_max,
 start,
 duration,
 experience,
 remote,
 location,
 key_skills,
 insert_date,
 description
from `processing-dev-394419`.`freework`.`job_list`
 where  key_skills like '%Freelance%'and key_skills  like '%CDI%'

  and insert_date > (select coalesce(max(insert_date), '1900-01-01') from `processing-dev-394419`.`freework`.`jobs_cleaning_freelance_cdi`)

)

select  
*
from source_data
    );
  
      -- 2. define partitions to update
      set (dbt_partitions_for_replacement) = (
          select as struct
              -- IGNORE NULLS: this needs to be aligned to _dbt_max_partition, which ignores null
              array_agg(distinct date(insert_date) IGNORE NULLS)
          from `processing-dev-394419`.`freework`.`jobs_cleaning_freelance_cdi__dbt_tmp`
      );

      -- 3. run the merge statement
      

    merge into `processing-dev-394419`.`freework`.`jobs_cleaning_freelance_cdi` as DBT_INTERNAL_DEST
        using (
        select
        * from `processing-dev-394419`.`freework`.`jobs_cleaning_freelance_cdi__dbt_tmp`
      ) as DBT_INTERNAL_SOURCE
        on FALSE

    when not matched by source
         and date(DBT_INTERNAL_DEST.insert_date) in unnest(dbt_partitions_for_replacement) 
        then delete

    when not matched then insert
        (`job`, `job_type`, `salary_min`, `salary_max`, `tjm_min`, `tjm_max`, `start`, `duration`, `experience`, `remote`, `location`, `key_skills`)
    values
        (`job`, `job_type`, `salary_min`, `salary_max`, `tjm_min`, `tjm_max`, `start`, `duration`, `experience`, `remote`, `location`, `key_skills`)

;

