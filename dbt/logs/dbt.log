REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(profil,r'Ã©', 'é'),r'Ã¨', 'è'),r'Ã¢', 'â'),r'Ã´', 'ô'),
