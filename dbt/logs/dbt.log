        * from `processing-dev-394419`.`freework`.`jobs_cleaning_freelance__dbt_tmp`
      ) as DBT_INTERNAL_SOURCE
        on FALSE

    when not matched by source
         and date(DBT_INTERNAL_DEST.insert_date) in unnest(dbt_partitions_for_replacement) 
        then delete

    when not matched then insert
        (`job`, `job_type`, `tjm_min`, `tjm_max`, `start`, `duration`, `experience`, `remote`, `location`, `key_skills`, `insert_date`)
    values
        (`job`, `job_type`, `tjm_min`, `tjm_max`, `start`, `duration`, `experience`, `remote`, `location`, `key_skills`, `insert_date`)

;

