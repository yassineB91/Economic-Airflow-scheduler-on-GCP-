with source_data as (
with jobs_table as 
(
select
distinct 
job, salary_min,salary_max,tjm_min,
tjm_max,start, job_type, duration, experience, remote, location, key_skills
from `processing-dev-394419`.`freework`.`jobs_cleaning_aggregation` 
where job<>''
)

select distinct

to_hex(md5(cast(coalesce(cast(j.job as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(l.location_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(j.duration as string), '_dbt_utils_surrogate_key_null_') as string))) as job_id,
