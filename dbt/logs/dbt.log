 start,
 duration,
 experience,
 remote,
 location,
 key_skills,
 insert_date
from `processing-dev-394419`.`freework`.`job_list`
 where  key_skills like '%Freelance%'and key_skills not like '%CDI%'

  and insert_date > (select coalesce(max(insert_date), '1900-01-01') from `processing-dev-394419`.`freework`.`jobs_cleaning_freelance`)

)


