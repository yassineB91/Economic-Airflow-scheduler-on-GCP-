    create or replace table `processing-dev-394419`.`freework`.`jobs_cleaning_cdi`
      
    partition by insert_date
    

    OPTIONS()
    as (
      

with source_data as (
select distinct
split(title,"-")[0] as job,
"CDI" as job_type,
safe_cast(replace(split(salary_tjm,"-")[SAFE_OFFSET(0)],"k","000") as numeric) as salary_min,
safe_cast(replace(split(salary_tjm,"-")[SAFE_OFFSET(1)],"k €/an","000") as numeric) as salary_max,
 start,
 duration,
 experience,
 remote,
 location,
 key_skills,
 insert_date
from `processing-dev-394419`.`freework`.`job_list`
 where  key_skills not like '%Freelance%'and key_skills  like '%CDI%' 
 and split(title,"-")[0]<>''


)

select  
*
from source_data
    );
  
