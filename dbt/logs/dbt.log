          select as struct
              -- IGNORE NULLS: this needs to be aligned to _dbt_max_partition, which ignores null
              array_agg(distinct timestamp_trunc(insert_date, day) IGNORE NULLS)
          from `processing-dev-394419`.`freework`.`jobs_cleaning_cdi__dbt_tmp`
      );

