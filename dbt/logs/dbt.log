REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(REGEXP_REPLACE(skills,r'Ã©', 'é'),r'Ã¨', 'è'),r'Ã¢', 'â'),r'Ã´', 'ô'),
