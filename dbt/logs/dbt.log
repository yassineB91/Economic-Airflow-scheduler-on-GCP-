            when a_query.location is null and b_query.location is null then 1
            when a_query.location_id is null then 2
            when b_query.location_id is null then 3
            when a_query.location is null then 4
            when b_query.location is null then 5
            when a_query.location != b_query.location then 6
            else 7 -- this should never happen
        end as match_order

    from a_query

    full outer join b_query on a_query.location_id = b_query.location_id
),

aggregated as (
    select
        'location' as column_name,
        match_status,
        match_order,
        count(*) as count_records
    from joined

    group by column_name, match_status, match_order
)

select
    column_name,
    match_status,
    count_records,
    round(100.0 * count_records / sum(count_records) over (), 2) as percent_of_total

from aggregated

order by match_order


  
