    merge into `processing-dev-394419`.`freework`.`jobs_cleaning_freelance` as DBT_INTERNAL_DEST
        using (

with source_data as (
select 
split(title,"-")[0] as job,
"Freelance" as job_type,
safe_cast(split(salary_tjm,"-")[0] as numeric) as tjm_min,
safe_cast(split(split(split(salary_tjm,"-")[SAFE_OFFSET(1)],",")[SAFE_OFFSET(0)],"€")[SAFE_OFFSET(0)] as numeric) as tjm_max,
 start,
 duration,
 experience,
 remote,
 location,
 key_skills,
 insert_date
from `processing-dev-394419`.`freework`.`job_list`
 where  key_skills like '%Freelance%'and key_skills not like '%CDI%'
 
and insert_date >= (
    select COALESCE(MAX(insert_date), '1900-01-01')
    from `processing-dev-394419`.`freework`.`jobs_cleaning_freelance`
)

)

select  
*
from source_data
        ) as DBT_INTERNAL_SOURCE
        on (
                DBT_INTERNAL_SOURCE.insert_date = DBT_INTERNAL_DEST.insert_date
            )

    
    when matched then update set
        `job` = DBT_INTERNAL_SOURCE.`job`,`job_type` = DBT_INTERNAL_SOURCE.`job_type`,`tjm_min` = DBT_INTERNAL_SOURCE.`tjm_min`,`tjm_max` = DBT_INTERNAL_SOURCE.`tjm_max`,`start` = DBT_INTERNAL_SOURCE.`start`,`duration` = DBT_INTERNAL_SOURCE.`duration`,`experience` = DBT_INTERNAL_SOURCE.`experience`,`remote` = DBT_INTERNAL_SOURCE.`remote`,`location` = DBT_INTERNAL_SOURCE.`location`,`key_skills` = DBT_INTERNAL_SOURCE.`key_skills`,`insert_date` = DBT_INTERNAL_SOURCE.`insert_date`
    

    when not matched then insert
        (`job`, `job_type`, `tjm_min`, `tjm_max`, `start`, `duration`, `experience`, `remote`, `location`, `key_skills`, `insert_date`)
    values
        (`job`, `job_type`, `tjm_min`, `tjm_max`, `start`, `duration`, `experience`, `remote`, `location`, `key_skills`, `insert_date`)


    
