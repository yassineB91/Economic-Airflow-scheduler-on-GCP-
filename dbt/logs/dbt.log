),

 stg_jobs as (
select 
 array_to_string(freework.remove_stop_words(TEXT_ANALYZE(REGEXP_REPLACE(NORMALIZE(title, NFD), r"\pM", ''), analyzer=>'PATTERN_ANALYZER')),' ') as title,
  SPLIT(skills, ',') as skills,
