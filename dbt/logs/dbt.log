safe_cast(replace(split(salary_tjm,"-")[SAFE_OFFSET(1)],"k €/an","000") as numeric) as salary_max,
 start,
 duration,
 experience,
 remote,
 location,
 key_skills,
 insert_date
from `processing-dev-394419`.`freework`.`job_list`
 where  key_skills not like '%Freelance%'and key_skills  like '%CDI%' 
 and split(title,"-")[0]<>''

  and insert_date > (select coalesce(max(insert_date), '1900-01-01') from `processing-dev-394419`.`freework`.`jobs_cleaning_cdi`)


)

