    create or replace table `processing-dev-394419`.`freework`.`jobs_modeling_bridge_job_skill`
      
    
    

    OPTIONS()
    as (
      

with source_data as (
with job_skill as (
SELECT 
distinct 
job,
replace(replace(replace(skills,"[",""),"]",""),"'","") as skill
 FROM `processing-dev-394419.freework.jobs_cleaning_aggregation` ,
 unnest(split(key_skills,",")) as skills
 where replace(replace(replace(skills,"[",""),"]",""),"'","")<>"CDI"
 and replace(replace(replace(skills,"[",""),"]",""),"'","") <>"Freelance"
 )
 select js.skill,js.job , j.job_id, s.skill_id
 from job_skill js
 left outer join `processing-dev-394419`.`freework`.`jobs_modeling_fact_jobs` j
 on js.job=j.job
 left outer join `processing-dev-394419`.`freework`.`jobs_modeling_skills` s
 on js.skill=s.skill)
 select * from source_data
    );
  
