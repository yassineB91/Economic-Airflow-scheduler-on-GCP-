with source_data as (
with job_skill as (
SELECT 
distinct 
job,

    trim((replace(replace(replace(skills,"[",""),"]",""),"'","")))
 as skill
 FROM `processing-dev-394419`.`freework`.`jobs_cleaning_aggregation` ,
 unnest(split(key_skills,",")) as skills
 where 
    trim((replace(replace(replace(skills,"[",""),"]",""),"'","")))
<>"CDI"
 and 
    trim((replace(replace(replace(skills,"[",""),"]",""),"'","")))
 <>"Freelance"

  and insert_date > (select coalesce(max(insert_date), '1900-01-01') from `processing-dev-394419`.`freework`.`jobs_modeling_bridge_job_skill`)

 )
 select js.skill,js.job , j.job_id, s.skill_id
 from job_skill js
 left outer join `processing-dev-394419`.`freework`.`jobs_modeling_fact_jobs_initial` j
 on js.job=j.job
 left outer join `processing-dev-394419`.`freework`.`jobs_modeling_skills` s
 on js.skill=s.skill)
 select * from source_data
        ) as DBT_INTERNAL_SOURCE
        on (
                    DBT_INTERNAL_SOURCE.job_id = DBT_INTERNAL_DEST.job_id
                ) and (
                    DBT_INTERNAL_SOURCE.skill_id = DBT_INTERNAL_DEST.skill_id
                )

    
