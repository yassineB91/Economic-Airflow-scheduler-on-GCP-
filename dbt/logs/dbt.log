    merge into `processing-dev-394419`.`freework`.`jobs_modeling_fact_jobs` as DBT_INTERNAL_DEST
        using (

with source_data as (
select j.*,r.job_category from `processing-dev-394419`.`freework`.`jobs_modeling_fact_jobs_initial` j

  where insert_date > (select coalesce(max(insert_date), '1900-01-01') from `processing-dev-394419`.`freework`.`jobs_modeling_fact_jobs`)

left outer join `processing-dev-394419`.`freework`.`jobs_modeling_ref_job_category` r
on j.job_id=r.job_id
)
select * from source_data
        ) as DBT_INTERNAL_SOURCE
        on (
                DBT_INTERNAL_SOURCE.job_id = DBT_INTERNAL_DEST.job_id
            )

    
    when matched then update set
        `job_id` = DBT_INTERNAL_SOURCE.`job_id`,`job` = DBT_INTERNAL_SOURCE.`job`,`salary_min` = DBT_INTERNAL_SOURCE.`salary_min`,`salary_max` = DBT_INTERNAL_SOURCE.`salary_max`,`tjm_min` = DBT_INTERNAL_SOURCE.`tjm_min`,`tjm_max` = DBT_INTERNAL_SOURCE.`tjm_max`,`start` = DBT_INTERNAL_SOURCE.`start`,`duration` = DBT_INTERNAL_SOURCE.`duration`,`key_skills` = DBT_INTERNAL_SOURCE.`key_skills`,`experience_id` = DBT_INTERNAL_SOURCE.`experience_id`,`location_id` = DBT_INTERNAL_SOURCE.`location_id`,`job_type_id` = DBT_INTERNAL_SOURCE.`job_type_id`,`insert_date` = DBT_INTERNAL_SOURCE.`insert_date`,`job_category` = DBT_INTERNAL_SOURCE.`job_category`
    

    when not matched then insert
        (`job_id`, `job`, `salary_min`, `salary_max`, `tjm_min`, `tjm_max`, `start`, `duration`, `key_skills`, `experience_id`, `location_id`, `job_type_id`, `insert_date`, `job_category`)
