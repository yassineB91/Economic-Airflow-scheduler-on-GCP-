        `skill` = DBT_INTERNAL_SOURCE.`skill`,`job` = DBT_INTERNAL_SOURCE.`job`,`job_id` = DBT_INTERNAL_SOURCE.`job_id`,`skill_id` = DBT_INTERNAL_SOURCE.`skill_id`
    

    when not matched then insert
        (`skill`, `job`, `job_id`, `skill_id`)
    values
        (`skill`, `job`, `job_id`, `skill_id`)


    
