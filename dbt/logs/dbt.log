[0m20:19:45.254421 [debug] [Thread-1 (]: On model.processing.compare_columns_location: /* {"app": "dbt", "dbt_version": "1.8.1", "profile_name": "processing", "target_name": "freework", "node_id": "model.processing.compare_columns_location"} */

    with a_query as (
    
select * from `processing-dev-394419`.`freework`.`jobs_modeling_location`
where is_latest

),

b_query as (
    
select * from `processing-dev-394419`.`freework`.`jobs_modeling_location_standardized`

),

joined as (
    select
        coalesce(a_query.location_id, b_query.location_id) as location_id,
        a_query.location as a_query_value,
        b_query.location as b_query_value,
        case
            when a_query.location = b_query.location then '✅: perfect match'
            when a_query.location is null and b_query.location is null then '✅: both are null'
            when a_query.location_id is null then '🤷: ‍missing from a'
            when b_query.location_id is null then '🤷: missing from b'
            when a_query.location is null then '🤷: value is null in a only'
            when b_query.location is null then '🤷: value is null in b only'
            when a_query.location != b_query.location then '🙅: ‍values do not match'
            else 'unknown' -- this should never happen
        end as match_status,
        case
            when a_query.location = b_query.location then 0
            when a_query.location is null and b_query.location is null then 1
            when a_query.location_id is null then 2
            when b_query.location_id is null then 3
            when a_query.location is null then 4
            when b_query.location is null then 5
            when a_query.location != b_query.location then 6
            else 7 -- this should never happen
        end as match_order

    from a_query

    full outer join b_query on a_query.location_id = b_query.location_id
),

aggregated as (
    select
        'location' as column_name,
        match_status,
        match_order,
        count(*) as count_records
    from joined

    group by column_name, match_status, match_order
)

select
    column_name,
    match_status,
    count_records,
    round(100.0 * count_records / sum(count_records) over (), 2) as percent_of_total

from aggregated

order by match_order


  
