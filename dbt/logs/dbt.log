        using (
    
with source_data as (
with exp as (select
distinct 
experience
from `processing-dev-394419`.`freework`.`jobs_cleaning_aggregation`

  where insert_date > (select coalesce(max(insert_date), '1900-01-01') from `processing-dev-394419`.`freework`.`jobs_modeling_experience`)

)
select 
to_hex(md5(cast(coalesce(cast(experience as string), '_dbt_utils_surrogate_key_null_') as string))) as experience_id,
experience
from exp
)
select * from source_data
        ) as DBT_INTERNAL_SOURCE
        on (
                DBT_INTERNAL_SOURCE.experience_id = DBT_INTERNAL_DEST.experience_id
            )

    
    when matched then update set
        `experience_id` = DBT_INTERNAL_SOURCE.`experience_id`,`experience` = DBT_INTERNAL_SOURCE.`experience`
    

    when not matched then insert
        (`experience_id`, `experience`)
    values
        (`experience_id`, `experience`)


    
