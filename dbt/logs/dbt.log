    create or replace table `processing-dev-394419`.`freework`.`jobs_modeling_skills`
      
    
    

    OPTIONS()
    as (
      

with source_data as (

with technologies as  (
SELECT 
distinct 

    (replace(replace(replace(skills,"[",""),"]",""),"'","")::STRING)
 as skill
 FROM `processing-dev-394419`.`freework`.`jobs_cleaning_aggregation` ,
 unnest(split(key_skills,",")) as skills
 where 
    (replace(replace(replace(skills,"[",""),"]",""),"'","")::STRING)
<>"CDI"
 and 
    (replace(replace(replace(skills,"[",""),"]",""),"'","")::STRING)
 <>"Freelance"
 )
 select
 to_hex(md5(cast(coalesce(cast(skill as string), '_dbt_utils_surrogate_key_null_') as string))) as skill_id,
 skill
 from technologies
)
select * from source_data
    );
  
